# ---- Bo's brain (optional; deterministic coach without it) ----
# DeepSeek powers the AI coach (deepseek-v4-flash, OpenAI-compatible).
# Set this in your deployment env (e.g. Vercel) — never commit a real key.
# Without it, Bo runs on the built-in deterministic replies.
DEEPSEEK_API_KEY=
# Optional model override (defaults to deepseek-v4-flash).
DEEPSEEK_MODEL=
# Optional owner-dashboard pricing overrides, per one million tokens.
DEEPSEEK_INPUT_USD_PER_MILLION=0.14
DEEPSEEK_OUTPUT_USD_PER_MILLION=0.28

# ---- Cloud mode: accounts + cross-device sync + shared community ----
# Create a free project at supabase.com, then run supabase/schema.sql
# in the SQL editor. Without these, Bygga runs in local-device mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (server only — used by the nudge cron). Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Payments: upfront Stripe Checkout for the $49 one-time programme ----
# Test mode key (sk_test_...) until launch. Without it the paywall
# uses the labeled demo unlock.
STRIPE_SECRET_KEY=
# Stripe signs payment, refund and dispute events sent to /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# ---- Bo's scheduled email nudges and checkout recovery (Resend + hourly crons) ----
RESEND_API_KEY=
# Signing secret for Resend events sent to /api/resend/webhook.
RESEND_WEBHOOK_SECRET=
# HMAC secret for signed one-click email opt-out links. Use a different random value from the webhook secret.
EMAIL_UNSUBSCRIBE_SECRET=
NUDGE_FROM="Bo at Badger AI <bo@badger.example.com>"
# Protects /api/nudge so only Vercel cron can trigger sends.
CRON_SECRET=

# ---- Web Push notifications ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@badger.example.com

# ---- Optional 10-person iMessage coaching pilot (Linq V3 sandbox) ----
# The tester always texts first. Subscribe the signed webhook URL to
# message.received, message.delivered, message.read and message.failed using
# webhook version 2026-02-03.
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
LINQ_PHONE_NUMBER=
# Exactly 32 random bytes, base64 or 64-character hex. Used for AES-GCM
# protection and HMAC lookup of phone numbers and one-time link codes.
MESSAGING_DATA_KEY=

# ---- Misc ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated signed-in emails allowed to open /ops.
OWNER_EMAILS=
# Daily private chairman brief. The hourly cron sends once at this local hour.
COMPANY_OWNER_TIMEZONE=UTC
COMPANY_OWNER_BRIEF_HOUR=9
# Optional transcription pricing overrides used for cost estimates.
GROQ_WHISPER_USD_PER_HOUR=0.04
OPENAI_WHISPER_USD_PER_MINUTE=0.006
# Set only for an intentional local/preview analytics test. Live Vercel
# deployments record automatically when VERCEL_ENV=production.
ALLOW_NONPRODUCTION_ANALYTICS=false

# ---- Badger Company OS: optional bounded execution connectors ----
# Optional external engineering worker. Leave blank for the local demo.
COMPANY_ENGINEERING_WEBHOOK_URL=
COMPANY_ENGINEERING_WEBHOOK_SECRET=
# Optional callback credential held by the worker/tool, never included in job text.
COMPANY_AUTOMATION_CALLBACK_SECRET=
# Optional publisher for your own Instagram professional account.
# The token needs instagram_business_basic and instagram_business_content_publish.
# The account username is checked before every post to prevent publishing to the wrong profile.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_BUSINESS_ACCESS_TOKEN=
INSTAGRAM_EXPECTED_USERNAME=badger.example.com
INSTAGRAM_GRAPH_API_VERSION=v26.0
# Private Company OS inbox. AgentMail signs inbound message.received events
# before they are stored; replies remain owner-authored and owner-approved.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
# Legacy production alias still accepted during migration.
AGENTMAIL_INBOX=
AGENTMAIL_INBOX_EMAIL=
AGENTMAIL_WEBHOOK_SECRET=
# Optional alternative for another fixed social automation provider. It is used only
# when none of the direct Instagram values are present.
COMPANY_SOCIAL_WEBHOOK_URL=
COMPANY_SOCIAL_WEBHOOK_SECRET=

# Optional Sendblue iMessage transport. Configure one iMessage provider.
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
SENDBLUE_WEBHOOK_SECRET=
SENDBLUE_PHONE_NUMBER=

# Optional Company OS owner Telegram notifications and approvals.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
